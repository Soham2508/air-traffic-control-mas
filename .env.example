# ATC MAS Environment Variables Example
# Copy this file to .env to configure local settings. Never commit secrets.

# CrewAI / LLM Settings (Optional - deterministic conflict detection runs without any API key)
# Example models: gemini/gemini-1.5-flash, openai/gpt-4o-mini
ATC_MAS_LLM_MODEL=gemini/gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

